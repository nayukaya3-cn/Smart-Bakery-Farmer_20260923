+def open_groups(groups: dict[str, list[str]], parents) -> dict:
+    """グループごとに、中身が2つ以上なら子タブを作る。1つならそのまま使う。"""
+    out = {}
+    for parent, names in zip(parents, groups.values()):
+        if len(names) == 1:
+            out[names[0]] = parent
+        else:
+            with parent:
+                out.update(zip(names, st.tabs(names)))
+    return out
