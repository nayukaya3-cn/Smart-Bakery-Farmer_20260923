+def ladder_ready(successes: int, n: int, threshold: float = 0.9, need: float = 0.8) -> dict:
+    """段を進めるかの材料：「自分でできる確率が threshold を超える」見込み（ベイズ）が need 以上か。決めるのは人。"""
+    a, b = beta_posterior(successes, n)
+    p = prob_above(a, b, threshold)
+    return {"見込み": p, "材料": "進む相談をしてよい" if p >= need else "この段を続ける"}
