+def robot_training_need(power_w: float, task: str, is_worker: bool = True) -> dict:
+    """その人・その作業に、産業用ロボットの特別教育が要るか。結論は「確かめる先」とセットで返す。"""
+    kind, why = ROBOT_TASKS[task]
+    if power_w <= 80:
+        return {"判定": "対象外（80W以下）", "区分": None, "時間": 0,
+                "理由": "告示第51号で産業用ロボットから除かれる。特別教育の義務はないが、リスクアセスメントと手順は同じように行う"}
+    if kind is None:
+        return {"判定": "対象外（この作業）", "区分": None, "時間": 0, "理由": why}
+    hours = int(TOKUBETSU_HOURS.loc[TOKUBETSU_HOURS["区分"] == kind, "時間（以上）"].sum())
+    if not is_worker:
+        return {"判定": "生徒・実習生に割り当てない作業", "区分": kind, "時間": hours,
+                "理由": f"{why}。特別教育は事業者が労働者に行うもの。実習生には任せず、大人（修了者）が担当する"}
+    return {"判定": "特別教育が必要", "区分": kind, "時間": hours, "理由": why}
+
