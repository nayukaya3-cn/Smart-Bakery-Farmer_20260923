+    "idx_n = rng.permutation(np.where(y == 0)[0])\n",
+    "idx_a = rng.permutation(np.where(y == 1)[0])\n",
+    "n1, n2 = int(len(idx_n) * .6), int(len(idx_n) * .8)\n",
+    "tr = idx_n[:n1]\n",
+    "va = np.r_[idx_n[n1:n2], idx_a[: len(idx_a) // 2]]\n",
+    "te = np.r_[idx_n[n2:], idx_a[len(idx_a) // 2:]]\n",
+    "print({\"学習（良品のみ）\": len(tr), \"検証\": len(va), \"テスト\": len(te),\n",
+    "       \"テストの異常\": int(y[te].sum())})\n",
+    "\n",
+    "X = X_img.reshape(len(X_img), -1)                         # 0〜1 のまま（標準化しない）\n",
+    "ALPHA = 0.01                                              # 良品の 1% は誤報してよい\n",
+    "\n",
+    "def thr_from_val(score):\n",
+    "    # 閾値は「検証の良品」の (1-α) 分位点。異常のデータは見ない\n",
+    "    v = va[y[va] == 0]\n",
+    "    return float(np.quantile(score[v], 1 - ALPHA))\n",
+    "\n",
+    "SCORES, THR = {}, {}"
+   ]
