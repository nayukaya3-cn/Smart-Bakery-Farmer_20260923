+    "# A. 特徴量＋ホテリングT²\n",
+    "Fx = F[[\"面積\", \"平均の明るさ\", \"暗い画素の割合\"]].to_numpy()\n",
+    "mu, S = Fx[tr].mean(0), np.cov(Fx[tr], rowvar=False)\n",
+    "d = Fx - mu\n",
+    "SCORES[\"A. 特徴量＋T²\"] = np.einsum(\"ij,jk,ik->i\", d, np.linalg.pinv(S), d)\n",
+    "\n",
+    "# B. PCA の復元誤差（主成分の数は、良品のばらつきの 95% を説明する数）\n",
+    "pca = PCA(n_components=0.95, random_state=SEED).fit(X[tr])\n",
+    "Xrec = pca.inverse_transform(pca.transform(X))\n",
+    "SCORES[\"B. PCA復元誤差\"] = ((X - Xrec) ** 2).mean(1)\n",
+    "print(\"主成分の数:\", pca.n_components_)\n",
+    "\n",
+    "# C. PCA で落とした空間で One-Class SVM（大きいほど異常になるよう符号を反転）\n",
+    "Z = pca.transform(X)\n",
+    "oc = OneClassSVM(gamma=\"scale\", nu=0.05).fit(Z[tr])\n",
+    "SCORES[\"C. PCA＋One-Class SVM\"] = -oc.decision_function(Z)\n",
+    "\n",
+    "for k, s in SCORES.items():\n",
+    "    THR[k] = thr_from_val(s)\n",
+    "print({k: round(v, 4) for k, v in THR.items()})"
