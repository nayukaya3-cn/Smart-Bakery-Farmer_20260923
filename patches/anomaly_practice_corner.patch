+    "    dark = np.array([(im[b] < 0.25).mean() if b.any() else 0 for im, b in zip(imgs, body)])\n",
+    "    return pd.DataFrame({\"面積\": area, \"平均の明るさ\": mean_tone, \"暗い画素の割合\": dark})\n",
