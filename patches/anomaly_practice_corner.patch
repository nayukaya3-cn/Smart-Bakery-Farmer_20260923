+    "def bread_image(kind: str = \"良品\", rng=rng, size: int = SIZE) -> np.ndarray:\n",
+    "    yy, xx = np.mgrid[0:size, 0:size] / (size - 1) * 2 - 1\n",
+    "    cx, cy = rng.normal(0, 0.04, 2)\n",
+    "    rx, ry = rng.normal(0.68, 0.03), rng.normal(0.62, 0.03)\n",
+    "    ang = rng.uniform(0, np.pi)\n",
+    "    xr = (xx - cx) * np.cos(ang) + (yy - cy) * np.sin(ang)\n",
+    "    yr = -(xx - cx) * np.sin(ang) + (yy - cy) * np.cos(ang)\n",
+    "    r = np.sqrt((xr / rx) ** 2 + (yr / ry) ** 2)\n",
+    "    inside = r < 1\n",
+    "    tone = rng.normal(0.55, 0.03)                         # 焼き色（0=黒〜1=白）\n",
+    "    img = np.full((size, size), 0.92)                       # 背景（白い天板）\n",
+    "    crust = tone - 0.18 * r ** 2 + rng.normal(0, 0.02, (size, size))  # 縁ほど濃い\n",
+    "    img[inside] = crust[inside]\n",
+    "    if kind == \"焦げ\":\n",
+    "        px, py = rng.uniform(-0.35, 0.35, 2)\n",
+    "        spot = np.sqrt((xx - px) ** 2 + (yy - py) ** 2) < rng.uniform(0.12, 0.2)\n",
+    "        img[spot & inside] = rng.uniform(0.08, 0.18)\n",
+    "    elif kind == \"欠け\":\n",
+    "        a0 = rng.uniform(0, 2 * np.pi)\n",
+    "        theta = np.arctan2(yy - cy, xx - cx)\n",
+    "        cut = (np.abs(np.angle(np.exp(1j * (theta - a0)))) < 0.45) & (r > 0.45)\n",
+    "        img[inside & cut] = 0.92\n",
+    "    elif kind == \"生焼け\":\n",
+    "        img[inside] += 0.22\n",
+    "    return np.clip(img, 0, 1)\n",
+    "\n",
+    "\n",
+    "def make_dataset(n_normal=300, n_each=12):\n",
+    "    imgs, kinds = [], []\n",
+    "    for _ in range(n_normal):\n",
+    "        imgs.append(bread_image(\"良品\")); kinds.append(\"良品\")\n",
+    "    for k in [\"焦げ\", \"欠け\", \"生焼け\"]:\n",
+    "        for _ in range(n_each):\n",
+    "            imgs.append(bread_image(k)); kinds.append(k)\n",
+    "    return np.array(imgs), np.array(kinds)\n",
+    "\n",
+    "\n",
+    "def load_folder(folder: Path, default_kind: str):\n",
+    "    imgs, kinds = [], []\n",
+    "    for p in sorted(folder.glob(\"*\")):\n",
+    "        if p.suffix.lower() not in (\".png\", \".jpg\", \".jpeg\"):\n",
+    "            continue\n",
+    "        im = Image.open(p).convert(\"L\").resize((SIZE, SIZE))\n",
+    "        imgs.append(np.asarray(im, float) / 255.0)      # ← 標準化ではなく 0〜1 にするだけ\n",
+    "        kind = next((k for k in [\"焦げ\", \"欠け\", \"生焼け\"] if k in p.name), default_kind)\n",
+    "        kinds.append(kind)\n",
+    "    return imgs, kinds\n",
+    "\n",
+    "\n",
+    "if USE_DRIVE:\n",
