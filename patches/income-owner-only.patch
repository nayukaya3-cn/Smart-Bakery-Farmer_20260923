+# ─────────────────────────────────────────────────────────────
+# Streamlit Community Cloud → アプリ → Settings → Secrets に貼り付ける見本
+# ※ このファイル自体には本物の値を書かない。本物は Secrets 画面だけに入れる。
+# ─────────────────────────────────────────────────────────────
+
+# 収入構造ページを開けるGoogleアカウント（複数可）
+OWNER_EMAILS = ["you@gmail.com"]
+
+# Googleログイン（OpenID Connect）
+[auth]
+redirect_uri = "https://smart-bakery-farm.streamlit.app/oauth2callback"
+cookie_secret = "python -c \"import secrets; print(secrets.token_urlsafe(32))\" で作った文字列"
+client_id = "xxxxxxxx.apps.googleusercontent.com"
+client_secret = "GOCSPX-xxxxxxxx"
+server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
+
+# 収入構造の実際の値（コードには仮置きだけを残す）。書いた項目だけ上書きされる
+[income]
+koma_rate = 2800          # コマ給（円/コマ）
+koma_per_week = 6
+weeks_per_year = 35
+fee_per_school = 150000   # 探究プログラムの提示価格（円/校・年）
+schools_per_year = 1.0
+max_schools = 5
+dev_cost = 400000
+revise_cost = 30000
+saving_step = 40000
+saving_cap = 240000
