+"""
+ロボットの安全設計 — 産業用ロボット特別教育（教示等）の考え方を、畑の巡回ロボットに当てはめる
+
+app.py の「🤖 AIロボット」タブから rs.render(speed) で呼び出します。
+  ① 計算する  : 止まるまでの距離と、人との安全距離
+  ② 可視化する: 減速ゾーン・停止ゾーンと、人の位置
+  ③ 判断する  : リスクアセスメント（加算法）と、運転前チェック → 動かしてよいかの判定
+
+数値はすべて説明用の簡易モデルです。実機の安全設計は、メーカーの仕様と法令・規格に従います。
+"""
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+import plotly.graph_objects as go
+import streamlit as st
+
+# 修了証の画像そのもの（生年月日・証番号が載っている）は公開せず、文字情報だけを載せる。
+CERT = {
+    "名称": "産業用ロボットの教示等の業務に係る特別教育 修了",
+    "根拠": "労働安全衛生規則 第36条第31号",
+    "修了": "2026年6月",
+    "次の段階": "産業用ロボット特別教育 インストラクターコース（2026年12月 受講予定）",
+}
+
+# 特別教育で学ぶ考え方 → 畑の巡回ロボットでどう生かすか
+TRANSLATE = [
+    ("可動範囲（ロボットが届く範囲）を知る", "巡回ルートの両側に、ロボットが入りうる幅を決めて地面に目印をつける"),
+    ("教示中は、非常停止をすぐ押せる状態で作業する", "動かすときは、非常停止（ボタン・リモコン）を人が手に持って見守る"),
+    ("教示は低速で行う", "初めての経路・人がいる時間帯は、速度の上限を下げて走らせる"),
+    ("作業中であることを周りに表示する", "「ロボット運転中」の札を通路の入口に出す。見学者に先に説明する"),
+    ("作業開始前に点検する", "電池・ブレーキ・非常停止・カメラ・通信を、運転前チェックで毎回確かめる"),
+    ("異常時は止めてから近づく", "引っかかった・倒れたときは、必ず停止を確認してから手を出す"),
+]
+
+# リスクアセスメント（加算法）の点数表。中央労働災害防止協会などで広く使われる方式の一例。
+SEVERITY = {"致命傷": 10, "重傷（休業あり）": 6, "軽傷（休業なし）": 3, "かすり傷": 1}
+FREQUENCY = {"頻繁に近づく": 4, "ときどき近づく": 2, "ほとんど近づかない": 1}
+LIKELIHOOD = {"確実に起こる": 6, "起こる可能性が高い": 4, "起こる可能性がある": 2, "ほとんど起こらない": 1}
+
+DEFAULT_RISKS = pd.DataFrame([
+    ("見学の生徒がルートに入り、ぶつかる", "軽傷（休業なし）", "ときどき近づく", "起こる可能性がある",
+     "速度上限を下げる・停止ゾーンでの自動停止", "ルートの目印・運転中の札・事前説明"),
+    ("車椅子の通路とルートが交わる", "軽傷（休業なし）", "ときどき近づく", "起こる可能性がある",
+     "ルートを通路と交わらない形にする", "交わる場所では一時停止して人を待つ"),
+    ("段差・ぬかるみで転倒し、人の足に当たる", "かすり傷", "ほとんど近づかない", "起こる可能性がある",
+     "段差のない区画だけを走らせる", "雨のあとは運転しない"),
+    ("通信を乗っ取られ、勝手に動く", "軽傷（休業なし）", "ほとんど近づかない", "起こる可能性がある",
+     "初期パスワードの変更・通信の暗号化", "手元の非常停止は通信と別系統にする"),
+    ("カメラに人や近所の家が写り込む", "かすり傷", "ときどき近づく", "起こる可能性が高い",
+     "カメラの向きを地面に固定する", "写り込んだ写真は公開前に消す"),
+], columns=["危険のシナリオ", "重篤度", "頻度", "可能性", "対策①：設計で減らす", "対策②：守り方・知らせ方"])
+
+CHECKS = [
+    "非常停止（本体のボタン・手元のリモコン）が効くことを確かめた",
+    "電池の残りと、ブレーキの効きを確かめた",
+    "ルートの目印・「ロボット運転中」の札を出した",
+    "見学者に、近づいてよい距離と止め方を説明した",
+    "見守る人が1人、ロボットから目を離さない体制にした",
+    "通信機器のパスワードを初期値から変えてある",
+]
+
+
+def stop_distance(v: float, t_react: float, decel: float) -> float:
+    """止まるまでの距離 d = v·t + v² / (2a)  [m]"""
+    return v * t_react + v ** 2 / (2 * decel)
+
+
+def safety_distance(k_person: float, t_total: float, margin: float) -> float:
+    """人が近づく速さを考えた安全距離 S = K·T + C  [m]
+    （考え方は ISO 13855 の安全距離の式。K：人が近づく速さ、T：検知から停止までの時間、C：余裕）"""
+    return k_person * t_total + margin
+
+
+def risk_level(points: int) -> str:
+    if points >= 12:
+        return "Ⅳ すぐに対策"
+    if points >= 9:
+        return "Ⅲ 優先して対策"
+    if points >= 6:
+        return "Ⅱ 計画的に対策"
+    return "Ⅰ 必要に応じて対策"
+
+
+def render(robot_speed: float = 0.2) -> None:
+    st.subheader("🛡️ ロボットの安全設計：産業用ロボット特別教育を、畑に当てはめる")
+
+    c_cert, c_note = st.columns([3, 2])
+    with c_cert:
+        st.markdown(
+            f"**{CERT['名称']}**（{CERT['修了']}）\n\n"
+            f"根拠：{CERT['根拠']}\n\n"
+            f"次の段階：{CERT['次の段階']}"
+        )
+    with c_note:
+        st.info("教示（ロボットに動きを教える作業）のときの安全の考え方を、"
+                "畑を巡回する小型ロボットと、見学に来る生徒の安全に置きかえています。")
+
+    st.markdown("**特別教育で学ぶ考え方 → 畑でどう生かすか**")
+    st.dataframe(pd.DataFrame(TRANSLATE, columns=["特別教育で学ぶ考え方", "畑の巡回ロボットでは"]),
+                 width="stretch", hide_index=True)
+    st.caption("巡回用の小型ローバーは、モーターの定格出力が80W以下なら、法令上の「産業用ロボット」に当たらないことが多いです。"
+               "それでも、同じ考え方で安全をつくります。")
+
+    # ── ① 計算する ──────────────────────────
+    st.markdown("#### ① 計算する：止まるまでの距離と、安全距離")
+    a, b = st.columns([1, 2])
+    with a:
+        v = st.slider("ロボットの速さ m/秒", 0.05, 1.0, float(robot_speed), 0.05, key="rs_v",
+                      help="上の巡回ルート設計と同じ値から始まります")
+        t_detect = st.slider("人を見つけてから止め始めるまでの時間 秒", 0.1, 2.0, 0.5, 0.1)
+        decel = st.slider("ブレーキの強さ（減速度）m/秒²", 0.1, 2.0, 0.5, 0.1)
+        k_person = st.select_slider("人が近づく速さ", options=[0.5, 1.0, 1.6, 2.0], value=1.6,
+                                    format_func=lambda x: {0.5: "0.5 m/秒（車椅子・ゆっくり）", 1.0: "1.0 m/秒（ふつうに歩く）",
+                                                           1.6: "1.6 m/秒（規格の標準値）", 2.0: "2.0 m/秒（小走り）"}[x])
+        margin = st.slider("余裕（センサーのばらつき等）m", 0.0, 1.0, 0.3, 0.05)
+
+    d_stop = stop_distance(v, t_detect, decel)
+    t_stop = t_detect + v / decel
+    s_safe = safety_distance(k_person, t_stop, margin) + d_stop
+    slow_r = s_safe * 2  # 減速ゾーン：停止ゾーンの2倍を目安
+
+    with b:
+        m1, m2, m3 = st.columns(3)
+        m1.metric("止まるまでの距離", f"{d_stop:.2f} m")
+        m2.metric("止まるまでの時間", f"{t_stop:.1f} 秒")
+        m3.metric("停止ゾーンの半径", f"{s_safe:.2f} m")
+        st.latex(r"d = v\,t + \frac{v^2}{2a},\qquad S = K\,T + C + d")
+        st.caption("d：ロボットが止まるまでに進む距離、S：人がこれより近づいたら止める距離。"
+                   "人もロボットも動いているので、両方が近づく分を足しています（簡易モデル）。")
+
+    # ── ② 可視化する ─────────────────────────
+    st.markdown("#### ② 可視化する：減速ゾーンと停止ゾーン")
+    a2, b2 = st.columns([1, 2])
+    with a2:
+        dist = st.slider("人とロボットの距離 m", 0.0, 6.0, 2.5, 0.1)
+        if dist <= s_safe:
+            state, color = "停止", "#c0392b"
+            st.error(f"停止ゾーンの中です（{s_safe:.2f} m 以内）。ロボットは止まります。")
+        elif dist <= slow_r:
+            state, color = "減速", "#c98a2b"
+            st.warning(f"減速ゾーンです（{slow_r:.2f} m 以内）。速度を落として走ります。")
+        else:
+            state, color = "通常", "#6a9a4a"
+            st.success("ゾーンの外です。通常の速さで巡回します。")
+    with b2:
+        th = np.linspace(0, 2 * np.pi, 120)
+        fig = go.Figure()
+        for r, name, fill in [(slow_r, "減速ゾーン", "rgba(201,138,43,.18)"),
+                              (s_safe, "停止ゾーン", "rgba(192,57,43,.25)")]:
+            fig.add_trace(go.Scatter(x=r * np.cos(th), y=r * np.sin(th), fill="toself", fillcolor=fill,
+                                     line=dict(color=fill.replace(".18", "1").replace(".25", "1"), width=1),
+                                     name=f"{name}（半径 {r:.2f} m）", hoverinfo="name"))
+        fig.add_trace(go.Scatter(x=[0], y=[0], mode="markers+text", text=["ロボット"], textposition="bottom center",
+                                 marker=dict(size=16, symbol="square", color="#3b2f1e"), showlegend=False))
+        fig.add_trace(go.Scatter(x=[dist], y=[0], mode="markers+text", text=[f"人（{state}）"],
+                                 textposition="top center", marker=dict(size=14, color=color), showlegend=False))
+        lim = max(slow_r, dist) + 0.5
+        fig.update_xaxes(range=[-lim, lim], title="m", zeroline=False)
+        fig.update_yaxes(range=[-lim, lim], scaleanchor="x", scaleratio=1, zeroline=False)
+        fig.update_layout(height=380, margin=dict(l=10, r=10, t=10, b=10), legend=dict(orientation="h", y=1.08))
+        st.plotly_chart(fig, width="stretch")
+
+    st.markdown("**速さを変えると、停止ゾーンはどう広がるか**")
+    vs = np.linspace(0.05, 1.0, 40)
+    zone = [safety_distance(k_person, t_detect + x / decel, margin) + stop_distance(x, t_detect, decel) for x in vs]
+    fig2 = go.Figure(go.Scatter(x=vs, y=zone, line=dict(color="#8a4b12", width=3), name="停止ゾーンの半径"))
+    fig2.add_vline(x=v, line_dash="dot", line_color="#555", annotation_text="いまの設定")
+    fig2.update_layout(height=260, margin=dict(l=10, r=10, t=10, b=10),
+                       xaxis_title="ロボットの速さ m/秒", yaxis_title="停止ゾーンの半径 m")
+    st.plotly_chart(fig2, width="stretch")
+    st.caption("速さを半分にすると、ブレーキで進む距離は4分の1になります（速さの2乗に比例）。"
+               "人がいる時間帯に速度の上限を下げるのは、このためです。")
+
+    # ── ③ 自分の条件で判断する ─────────────────
+    st.markdown("#### ③ 自分の条件で判断する：リスクアセスメント → 動かしてよいか")
