+COURSES = pd.DataFrame([
+    ("0 紙とブラウザ", "企画書・地図・看板の文章・案内役のセリフをつくる（このページだけで完結）",
+     "このページ・紙・ペン", "なし", "1〜2週"),
+    ("A アバター", "VRoid Studio で案内役アバターをつくり、VRM で書き出す",
+     "VRoid Studio", "なし（マウス操作だけ）", "1〜2週"),
+    ("B ワールド", "Unity に箱と板を並べて畑を再現し、Vket Cloud でブラウザ公開する",
+     "Unity・Vket Cloud SDK", "なし（数値を入れるだけ）", "2〜3週"),
+    ("C ゲーム化", "「麦の穂あつめ」ゲームにする。C# のお手本を写して、少しだけ改造する",
+     "Unity・Visual Studio", "あり（写して改造）", "3〜4週"),
+], columns=["コース", "やること", "使う道具", "プログラミング", "目安"])
+
+ROLES = pd.DataFrame([
+    ("プランナー", "だれに・何を伝えるワールドか決める。企画書を書く", "国語・総合探究"),
+    ("ライター", "看板の説明文・案内役のセリフを書く。読みやすさを確かめる", "国語・英語"),
+    ("デザイナー", "地図を描き、色と配置を決める。アバターをつくる", "美術"),
+    ("ビルダー", "Unity に配置表の数値を入れて、ワールドを組み立てる", "情報"),
+    ("リサーチャー", "アンケートをとり、何人が・どこで迷ったかを数える", "数学・公民"),
+], columns=["役割", "やること", "生かせる教科"])
+
+
+# ─────────────────────────────────────────────
+# 計算の部品
+# ─────────────────────────────────────────────
+NAME_OK = re.compile(r"^[A-Za-z][A-Za-z0-9_]*$")
+
+
+def clean_world(df: pd.DataFrame) -> pd.DataFrame:
+    df = df.copy()
+    for c in ["X", "Z", "幅", "奥行き", "高さ"]:
+        df[c] = pd.to_numeric(df[c], errors="coerce").fillna(0.0)
+    df["名前（英数字）"] = df["名前（英数字）"].fillna("").astype(str).str.strip()
+    df["日本語ラベル"] = df["日本語ラベル"].fillna("").astype(str)
+    df["形"] = df["形"].where(df["形"].isin(["Cube", "Plane", "Cylinder"]), "Cube")
+    df["色"] = df["色"].where(df["色"].astype(str).str.match(r"^#[0-9a-fA-F]{6}$"), "#999999")
+    return df[df["名前（英数字）"] != ""].reset_index(drop=True)
+
+
+def unity_table(df: pd.DataFrame) -> pd.DataFrame:
+    """現実の寸法(m) → Unity の Position / Scale に変換する。
+
+    Cube    : 1辺1m の立方体。Scale = (幅, 高さ, 奥行き)、中心の高さ Y = 高さ/2
+    Plane   : 10m×10m の板。   Scale = (幅/10, 1, 奥行き/10)、Y = 0
+    Cylinder: 直径1m・高さ2m。 Scale = (直径, 高さ/2, 直径)、Y = 高さ/2
+    """
+    rows = []
+    for _, r in df.iterrows():
+        w, d, h = r["幅"], r["奥行き"], r["高さ"]
+        if r["形"] == "Plane":
+            pos_y, sc = 0.0, (w / 10, 1.0, d / 10)
+        elif r["形"] == "Cylinder":
+            pos_y, sc = h / 2, (w, h / 2, d)
+        else:
+            pos_y, sc = h / 2, (w, h, d)
+        rows.append({
+            "名前": r["名前（英数字）"], "ラベル": r["日本語ラベル"], "3D Object": r["形"],
+            "Position X": round(r["X"], 2), "Position Y": round(pos_y, 2), "Position Z": round(r["Z"], 2),
+            "Scale X": round(sc[0], 3), "Scale Y": round(sc[1], 3), "Scale Z": round(sc[2], 3),
+        })
+    return pd.DataFrame(rows)
+
+
+def gap(a: pd.Series, b: pd.Series) -> float:
+    """真上から見た2つの四角のすき間（m）。重なっていれば 0 未満。"""
+    dx = abs(a["X"] - b["X"]) - (a["幅"] + b["幅"]) / 2
+    dz = abs(a["Z"] - b["Z"]) - (a["奥行き"] + b["奥行き"]) / 2
+    if dx < 0 and dz < 0:
+        return max(dx, dz)          # 重なり（マイナス）
+    return max(dx, 0) if dz < 0 else (max(dz, 0) if dx < 0 else (dx**2 + dz**2) ** 0.5)
+
+
+def box_mesh(x, z, w, d, h, color, name, y0=0.0):
+    xs = [x - w/2, x + w/2, x + w/2, x - w/2] * 2
+    zs = [z - d/2, z - d/2, z + d/2, z + d/2] * 2
+    ys = [y0] * 4 + [y0 + max(h, 0.02)] * 4
+    i = [0, 0, 4, 4, 0, 0, 1, 1, 2, 2, 3, 3]
+    j = [1, 2, 5, 6, 1, 5, 2, 6, 3, 7, 0, 4]
+    k = [2, 3, 6, 7, 5, 4, 6, 5, 7, 6, 4, 7]
+    return go.Mesh3d(x=xs, y=zs, z=ys, i=i, j=j, k=k, color=color, opacity=1.0,
+                     flatshading=True, name=name, hovertext=name, hoverinfo="text")
+
+
+KANJI = re.compile(r"[\u4e00-\u9fff]")
+
+
+def read_check(text: str) -> dict:
+    text = str(text or "")
+    body = re.sub(r"\s", "", text)
+    sentences = [s for s in re.split(r"[。！？!?]", body) if s]
+    n = len(body)
+    return {
+        "文字数": n,
+        "文の数": len(sentences),
+        "いちばん長い文": max((len(s) for s in sentences), default=0),
+        "漢字の割合%": round(len(KANJI.findall(body)) / n * 100, 1) if n else 0.0,
+    }
