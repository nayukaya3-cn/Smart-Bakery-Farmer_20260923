+def plot(fig, h: int = 340, **kw) -> None:
+    has_title = bool(kw.get("title") or fig.layout.title.text)
+    fig.update_layout(height=h, margin=dict(l=10, r=10, t=50 if has_title else 10, b=10), **kw)
