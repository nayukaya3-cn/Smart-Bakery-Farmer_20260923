+   "metadata": {},
+   "execution_count": null,
+   "outputs": [],
+   "source": [
+    "cols = [\"赤\", \"近赤外\", \"短波長赤外\", \"NDVI\", \"NDWI\", \"VV dB（ならし後）\"]\n",
